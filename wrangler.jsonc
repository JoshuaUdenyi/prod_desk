{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "productiondesk",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Frontend: React SPA served from Workers Static Assets.
  // API routes are handled by the Worker first; everything else falls through to the SPA.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "productiondesk",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "productiondesk-files"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    "APP_ENV": "development",
    "SESSION_TTL_DAYS": "14"
  }
}
